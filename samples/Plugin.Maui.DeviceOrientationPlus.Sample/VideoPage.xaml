<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plugin.Maui.DeviceOrientationPlus.Sample.VideoPage"
             Title="Video"
             BackgroundColor="#111111">
    <Grid Padding="24">
        <VerticalStackLayout Spacing="12" VerticalOptions="Center">
            <Label Text="Landscape video / dashboard"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />
            <Label Text="OnAppearing calls Orientation.SetAsync(Landscape). OnDisappearing calls Unlock."
                   TextColor="#CCCCCC"
                   HorizontalTextAlignment="Center" />
            <Label x:Name="StatusLabel" TextColor="#888888" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
